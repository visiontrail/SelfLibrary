          <mxGeometry x="1800" y="1920" width="100" height="30" as="geometry" />
        </mxCell>
        <mxCell id="uxznR1Z2jdI1ehrrrHDE-37" value="kill所有进程：&lt;br&gt;&amp;nbsp;- CU和自研LTE使用信号15退出&lt;br&gt;&amp;nbsp;- 其他业务进程使用信号9退出" style="rounded=1;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="1710" y="2020" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="uxznR1Z2jdI1ehrrrHDE-38" value="RESTART_ALONE" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="2026" y="1950" width="117" height="30" as="geometry" />
        </mxCell>
        <mxCell id="uxznR1Z2jdI1ehrrrHDE-39" value="只重启其中某个进程" style="rounded=1;whiteSpace=wrap;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="2038" y="2020" width="210" height="60" as="geometry" />
        </mxCell>
        <mxCell id="uxznR1Z2jdI1ehrrrHDE-40" value="&lt;font style=&quot;font-size: 11px;&quot;&gt;&lt;b&gt;1.除CWMP、CWMP_LTE、webLMT，杀死所有业务进程&lt;/b&gt;&lt;br style=&quot;font-size: 11px;&quot;&gt;&amp;nbsp; &amp;nbsp;- CU和自研LTE使用信号15退出&lt;br style=&quot;border-color: var(--border-color); font-size: 11px;&quot;&gt;&lt;span style=&quot;font-size: 11px;&quot;&gt;&amp;nbsp; &amp;nbsp;- 其他业务进程使用信号9退出&lt;br style=&quot;font-size: 11px;&quot;&gt;&lt;/span&gt;&amp;nbsp; &amp;nbsp;- 向cu_ng_trans进程发送信号15，等待其释放和重建内存池&lt;br&gt;&lt;br&gt;&lt;b&gt;2.重新开始进入启动阶段&lt;/b&gt;&lt;br style=&quot;border-color: var(--border-color);&quot;&gt;&amp;nbsp; &amp;nbsp;- 重新进入启动阶段，并重新记录三次启动阶段机会&lt;br style=&quot;border-color: var(--border-color);&quot;&gt;&amp;nbsp; &amp;nbsp;- 三次失败后，直接Reboot重启服务器&lt;br style=&quot;font-size: 11px;&quot;&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;arcSize=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="2350" y="2020" width="320" height="120" as="geometry" />
        </mxCell>
        <mxCell id="uxznR1Z2jdI1ehrrrHDE-41" value="RESTART_BUS" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="2410" y="1920" width="100" height="30" as="geometry" />
        </mxCell>
      </root>

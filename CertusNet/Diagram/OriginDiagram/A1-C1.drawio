        <mxCell id="-W6PodagLXkbljqb8w8u-58" value="监控流程&lt;br style=&quot;border-color: var(--border-color); font-size: 9px;&quot;&gt;只执行告警后处理，&lt;font color=&quot;#ff3912&quot; style=&quot;font-size: 9px;&quot;&gt;一小时内3次告警重启，直接下电上电服务器&lt;br style=&quot;font-size: 9px;&quot;&gt;(NR-OAM指令)&lt;br style=&quot;font-size: 9px;&quot;&gt;&lt;/font&gt;" style="text;html=1;strokeColor=default;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;dashed=1;" parent="1" vertex="1">

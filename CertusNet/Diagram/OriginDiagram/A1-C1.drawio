        <mxCell id="uxznR1Z2jdI1ehrrrHDE-24" value="&lt;div style=&quot;font-size: 7px;&quot;&gt;660秒等待oam响应故障后处理，&lt;/div&gt;&lt;div style=&quot;font-size: 7px;&quot;&gt;&lt;span style=&quot;background-color: initial; font-size: 7px;&quot;&gt;超时后（可能OAM也异常了）&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 7px;&quot;&gt;直接重启全部业务进程&lt;/div&gt;&lt;div style=&quot;font-size: 7px;&quot;&gt;&lt;/div&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;（RESTART_BUS&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;）&lt;/span&gt;&lt;span style=&quot;font-size: 7px;&quot;&gt;&lt;br&gt;&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=7;" vertex="1" parent="1">

        </mxCell>
        <mxCell id="zfbZ34JhTHOlA76_7y1m-5" value="RRU\EU" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;" vertex="1" parent="1">
          <mxGeometry x="604.5" y="140" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="zfbZ34JhTHOlA76_7y1m-6" value="基站监听4334端口，并等待RRU、EU的Callhome接入请求后，基站使用预先协商好的用户名密码建立SSH连接，NetConf连接&lt;br&gt;（详见设备接入）" style="rounded=0;whiteSpace=wrap;html=1;fontSize=15;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="84" y="230" width="660" height="90" as="geometry" />
        </mxCell>
        <mxCell id="zfbZ34JhTHOlA76_7y1m-7" value="基站获取RRU基本信息，包括软件硬件版本、设备基本信息、RRU基本能力、用户面信息等&lt;br&gt;（详见获取RU基本信息）" style="rounded=0;whiteSpace=wrap;html=1;fontSize=15;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="84" y="330" width="660" height="90" as="geometry" />
        </mxCell>
        <mxCell id="zfbZ34JhTHOlA76_7y1m-8" value="获取基本信息后，判定该RRU合法后，对该RRU进行时延测量&lt;br&gt;（详见时延测量）" style="rounded=0;whiteSpace=wrap;html=1;fontSize=15;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="84" y="430" width="660" height="90" as="geometry" />
        </mxCell>
        <mxCell id="zfbZ34JhTHOlA76_7y1m-9" value="配置RRU的基本信息：时间、tx-endpoints、processing-elements，开启心跳检测&lt;br&gt;（详见配置RRU基本信息）" style="rounded=0;whiteSpace=wrap;html=1;fontSize=15;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="84" y="530" width="660" height="90" as="geometry" />
        </mxCell>
        <mxCell id="zfbZ34JhTHOlA76_7y1m-10" value="注册RRU所有Notification stream：告警、文件上传、升级文件下载事件、升级安装事件、升级激活事件&lt;br&gt;（详见配置RRU基本信息）" style="rounded=0;whiteSpace=wrap;html=1;fontSize=15;fillColor=#cdeb8b;strokeColor=#36393d;" vertex="1" parent="1">
          <mxGeometry x="84" y="630" width="660" height="90" as="geometry" />
        </mxCell>
        <mxCell id="zfbZ34JhTHOlA76_7y1m-11" value="通过harderware的yang节点上报的软件版本信息判断该RRU是否需要进行升级&lt;br&gt;（详见升级管理）" style="rounded=0;whiteSpace=wrap;html=1;fontSize=15;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="84" y="730" width="660" height="50" as="geometry" />
        </mxCell>
        <mxCell id="zfbZ34JhTHOlA76_7y1m-12" value="将RRU、EU Netconf Session发送给小区模块，激活RRU用户面配置" style="rounded=0;whiteSpace=wrap;html=1;fontSize=15;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="84" y="790" width="660" height="50" as="geometry" />
        </mxCell>
        <mxCell id="zfbZ34JhTHOlA76_7y1m-13" value="运行过程中根据实际情况，会向RRU发送休眠请求、日志上传请求等&lt;br&gt;（详见OTIC管理面附录C.1）" style="rounded=0;whiteSpace=wrap;html=1;fontSize=15;fillColor=#bac8d3;strokeColor=#23445d;" vertex="1" parent="1">
          <mxGeometry x="84" y="920" width="660" height="50" as="geometry" />
        </mxCell>
        <mxCell id="zfbZ34JhTHOlA76_7y1m-14" value="RRU、EU正常运行，并每20秒交互心跳消息………" style="rounded=0;whiteSpace=wrap;html=1;fontSize=15;fillColor=#60a917;strokeColor=#2D7600;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="84" y="870" width="660" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
